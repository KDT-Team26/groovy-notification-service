# groovy-notification-service 로컬 실행 시 참고용 환경변수 예시.
#
# 폴리레포 전환 계획서 6장 2단계(과도기) 기준, 이 레포 단독 docker-compose는 아직 없다.
# 로컬 통합 테스트는 당분간 원본 Groovy 레포의 docker-compose.local.yml을 그대로 참조한다
# (mysql/redis/kafka/identity-service와 함께 떠야 하기 때문). 이 파일은 application.yml이
# 실제로 읽는 환경변수 목록과 로컬 개발용 기본값을 문서화하는 용도다.
#
# 사용법: 이 파일을 .env로 복사한 뒤 필요한 값을 채우고, 셸에 로드하거나 실행 환경에 주입한다.
#   cp .env.example .env

# --- MySQL (notification_db 전용 스키마 + 전용 계정) ---
SPRING_DEV_DB_URL=jdbc:mysql://localhost:3306/notification_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DEV_DB_USERNAME=notification_service
SPRING_DEV_DB_PASSWORD=notification_service_local_only_pw
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Redis (SSE 인스턴스간 전파 pub/sub + 구독 티켓 저장) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka (Outbox 이벤트 소비, SASL/PLAIN 인증) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=

# --- identity-service JWKS 검증(발급자가 아니라 검증만) ---
JWT_JWKS_URL=http://identity-service:8081/.well-known/jwks.json
JWT_JWKS_CONNECT_TIMEOUT_MS=2000
JWT_JWKS_READ_TIMEOUT_MS=3000
JWT_JWKS_CACHE_TTL_SECONDS=300

# --- 분산 트레이싱(Tempo, TracingConfig 참고) ---
OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
